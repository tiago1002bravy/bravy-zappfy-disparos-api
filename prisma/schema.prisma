generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                      String   @id @default(cuid())
  name                    String
  slug                    String   @unique
  timezone                String   @default("America/Sao_Paulo")
  failureWebhookUrl       String?
  defaultInstanceName     String?
  defaultInstanceTokenEnc String?
  defaultParticipants     String[] @default([])
  // Números (E.164 sem +) adicionados automaticamente no próximo grupo de qualquer
  // shortlink do tenant quando ele rotaciona (item ACTIVE → FULL → pickItem).
  // Vazio = feature desativada. Add não-admin via Uazapi addParticipants.
  autoJoinPhones          String[] @default([])
  // Defaults aplicados em todo grupo criado (front/api/mcp). Override por chamada.
  defaultGroupAdmins      String[] @default([])
  defaultGroupDescription String?
  defaultGroupPictureMediaId String?
  defaultGroupLocked      Boolean  @default(true)
  defaultGroupAnnounce    Boolean  @default(true)
  // Fonte externa de contatos (por tenant): connection string Postgres cifrada
  // (AES-256-GCM, mesmo crypto.util das instâncias). Null = sync desativado.
  contactSourceDbUrlEnc   String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  users                User[]
  groups               Group[]
  groupLists           GroupList[]
  shortlinks           GroupShortlink[]
  messages             Message[]
  mediaAssets          MediaAsset[]
  schedules            Schedule[]
  groupUpdateSchedules GroupUpdateSchedule[]
  executions           Execution[]
  apiKeys              ApiKey[]
  instances            Instance[]
  contacts             Contact[]
  contactSyncState     ContactSyncState?
  wabaTemplates        WabaTemplate[]
  campaigns            Campaign[]
  campaignMessages     CampaignMessage[]
}

enum Role {
  OWNER
  ADMIN
  OPERATOR
}

enum WorkspaceRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model WorkspaceRequest {
  id                String                 @id @default(cuid())
  name              String
  slug              String
  requesterName     String
  requesterEmail    String
  passwordHash      String
  reason            String?
  status            WorkspaceRequestStatus @default(PENDING)
  createdAt         DateTime               @default(now())
  reviewedAt        DateTime?
  reviewedByEmail   String?
  rejectionReason   String?
  createdTenantId   String?

  @@index([status, createdAt])
}

model User {
  id        String   @id @default(cuid())
  tenantId  String
  email     String
  password  String
  name      String
  role      Role     @default(OPERATOR)
  // Conexão WhatsApp pessoal — quando preenchida, sobrescreve o default do tenant
  instanceName     String?
  instanceTokenEnc String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  apiKeys           ApiKey[]         @relation("UserApiKeys")
  createdShortlinks GroupShortlink[] @relation("CreatedShortlinks")

  @@unique([tenantId, email])
  @@index([tenantId])
}

model ApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  // userId opcional pra retro-compat. Quando preenchido, requests autenticadas
  // por essa key herdam a Conexão WhatsApp do user (refresh de shortlinks, etc).
  userId     String?
  name       String
  hash       String    @unique
  prefix     String
  scopes     String[]
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation("UserApiKeys", fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
}

model Group {
  id                String   @id @default(cuid())
  tenantId          String
  instanceName      String
  remoteId          String
  name              String
  description       String?
  pictureUrl        String?
  participantsCount Int?
  syncedAt          DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships    GroupListMembership[]
  shortlinkItems GroupShortlinkItem[]

  // false quando o sync detectou que o grupo nao existe mais na instancia
  // (preserva historico de shortlinks, schedules etc; UI filtra por padrao)
  active Boolean @default(true)

  @@unique([tenantId, instanceName, remoteId])
  @@index([tenantId, name])
  @@index([tenantId, instanceName, active])
}

model GroupShortlink {
  id          String  @id @default(cuid())
  tenantId    String
  // Usuário dono da Conexão WhatsApp usada pelo resolver (capacity check,
  // refresh on-demand, auto-create). Setado no create() = currentUserId.
  // Nullable pra retro-compat; resolver tem fallback pro primeiro OWNER do tenant
  // com instanceTokenEnc preenchido.
  createdById String?
  slug        String  @unique
  active      Boolean @default(true)

  // Rotacao
  strategy           ShortlinkStrategy @default(SEQUENTIAL)
  // Limite "duro" do grupo no WhatsApp — quando participantsCount >= hardCap, marca FULL
  hardCap            Int               @default(900)
  // Quantos cliques aguentar ANTES do primeiro recheck via Uazapi
  initialClickBudget Int               @default(800)
  // Fonte primaria de capacidade
  capacitySource     CapacitySource    @default(ZAPPFY)

  // Auto-criacao quando todos lotam
  autoCreate         Boolean @default(false)
  autoCreateInstance String?
  autoCreateTemplate String? // padrao: "Grupo {N}"

  // Totais agregados
  clicks        Int       @default(0)
  lastClickedAt DateTime?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?                 @relation("CreatedShortlinks", fields: [createdById], references: [id], onDelete: SetNull)
  items     GroupShortlinkItem[]
  clickLog  GroupShortlinkClick[]
  events    GroupShortlinkEvent[]

  @@index([tenantId])
  @@index([createdById])
}

model GroupShortlinkItem {
  id          String              @id @default(cuid())
  shortlinkId String
  groupId     String
  order       Int
  status      ShortlinkItemStatus @default(ACTIVE)

  currentInviteUrl String?
  lastRefreshedAt  DateTime?

  // Contadores e ciclo de capacidade
  clicks            Int       @default(0)
  lastClickedAt     DateTime?
  participantsCount Int?
  lastCheckedAt     DateTime?
  // Quando clicks >= nextCheckAtClicks, dispara recheck de capacidade
  nextCheckAtClicks Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shortlink GroupShortlink @relation(fields: [shortlinkId], references: [id], onDelete: Cascade)
  group     Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([shortlinkId, groupId])
  @@index([shortlinkId, status, order])
}

model GroupShortlinkClick {
  id          String   @id @default(cuid())
  shortlinkId String
  itemId      String?
  ip          String?
  userAgent   String?
  country     String?
  countryCode String?
  region      String?
  city        String?
  geoResolved Boolean  @default(false)
  createdAt   DateTime @default(now())

  shortlink GroupShortlink @relation(fields: [shortlinkId], references: [id], onDelete: Cascade)

  @@index([shortlinkId, createdAt])
  @@index([geoResolved, createdAt])
}

model GroupShortlinkEvent {
  id          String   @id @default(cuid())
  shortlinkId String
  itemId      String?
  type        String // recheck | promote_full | auto_create | uazapi_error | no_active_item | invite_refresh
  payload     Json?
  createdAt   DateTime @default(now())

  shortlink GroupShortlink @relation(fields: [shortlinkId], references: [id], onDelete: Cascade)

  @@index([shortlinkId, createdAt])
  @@index([type, createdAt])
}

enum ShortlinkStrategy {
  SEQUENTIAL
  ROUND_ROBIN
  RANDOM
}

enum CapacitySource {
  ZAPPFY
  CLICK_COUNT
}

enum ShortlinkItemStatus {
  ACTIVE
  FULL
  INVALID
  DISABLED
}

model GroupList {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships GroupListMembership[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model GroupListMembership {
  id          String @id @default(cuid())
  groupListId String
  groupId     String

  groupList GroupList @relation(fields: [groupListId], references: [id], onDelete: Cascade)
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupListId, groupId])
  @@index([groupId])
}

model MediaAsset {
  id        String   @id @default(cuid())
  tenantId  String
  s3Key     String
  mime      String
  size      Int
  thumbKey  String?
  // Soft-delete: politica do tenant é nunca apagar objetos do MinIO.
  // DELETE /media/:id apenas seta deletedAt e oculta do listing.
  deletedAt DateTime?
  createdAt DateTime @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messageMedias MessageMedia[]

  @@index([tenantId])
  @@index([tenantId, deletedAt])
}

model Message {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  text        String?
  mentionAll  Boolean  @default(true)
  // Enquete (opcional). Se pollChoices.length > 0, a mensagem é enviada como enquete.
  pollChoices         String[] @default([])
  pollSelectableCount Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  medias    MessageMedia[]
  schedules Schedule[]

  @@index([tenantId])
}

enum MessageMediaKind {
  AUTO       // detecta pelo mime
  IMAGE
  VIDEO
  AUDIO      // áudio normal (MP3/OGG, balão de música)
  PTT        // mensagem de voz (gravada, balão verde)
  DOCUMENT   // anexo genérico
}

model MessageMedia {
  id        String           @id @default(cuid())
  messageId String
  mediaId   String
  order     Int
  kind      MessageMediaKind @default(AUTO)

  message Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  media   MediaAsset @relation(fields: [mediaId], references: [id])

  @@unique([messageId, order])
}

enum ScheduleType {
  ONCE
  DAILY
  WEEKLY
  CUSTOM_CRON
}

enum ScheduleStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELED
}

model Schedule {
  id               String         @id @default(cuid())
  tenantId         String
  messageId        String
  instanceName     String
  instanceTokenEnc String
  groupRemoteIds   String[]
  groupListIds     String[]       @default([])
  // Rotação dinâmica baseada em shortlinks ATIVOS do tenant. Quando
  // shortlinkRotationEnabled=true, worker ignora groupRemoteIds estatico
  // e resolve no momento do disparo: pra cada slug, pega o item ACTIVE
  // atual + shortlinkPrevCount items anteriores (status=FULL, order desc).
  // Permite disparar so pra grupos quentes sem manter lista enorme de
  // grupos antigos com leads frios.
  shortlinkRotationEnabled Boolean @default(false)
  shortlinkSlugs           String[] @default([])
  shortlinkPrevCount       Int     @default(2)
  type             ScheduleType
  startAt          DateTime
  endAt            DateTime?
  cron             String?
  timezone         String         @default("America/Sao_Paulo")
  status           ScheduleStatus @default(ACTIVE)
  bullJobId        String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  message    Message     @relation(fields: [messageId], references: [id])
  executions Execution[]

  @@index([tenantId])
  @@index([status])
}

enum GroupUpdateTarget {
  NAME
  DESCRIPTION
  PICTURE
}

model GroupUpdateSchedule {
  id                String            @id @default(cuid())
  tenantId          String
  instanceName      String
  instanceTokenEnc  String
  groupRemoteId     String
  target            GroupUpdateTarget
  newName           String?
  newDescription    String?
  newPictureMediaId String?
  type              ScheduleType
  startAt           DateTime
  cron              String?
  status            ScheduleStatus    @default(ACTIVE)
  bullJobId         String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  executions Execution[]

  @@index([tenantId])
}

enum InstanceProvider {
  UAZAPI // API não-oficial (grupos) — comportamento legado
  CLOUD_API // WhatsApp Cloud API oficial (Meta) — envio 1:1 via template
}

model Instance {
  id               String    @id @default(cuid())
  tenantId         String
  label            String
  // CLOUD_API: instanceName = phoneNumberId (convenção pra manter o unique
  // não-nulo sem migration disruptiva). instanceTokenEnc = access token Meta
  // (System User, permanente) cifrado com o mesmo crypto.util.
  instanceName     String
  instanceTokenEnc String
  priority         Int       @default(0)
  active           Boolean   @default(true)
  lastFailedAt     DateTime?
  failureCount     Int       @default(0)
  provider           InstanceProvider @default(UAZAPI)
  phoneNumberId      String?
  wabaId             String?
  displayPhoneNumber String?
  // Limite de envios 1:1 por janela móvel de 24h; null = CLOUD_API_DEFAULT_DAILY_CAP.
  // Tiers da Meta: 250/1k/10k/100k por 24h — responsabilidade do operador.
  dailyCap           Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaignMessages CampaignMessage[]

  @@unique([tenantId, instanceName])
  @@index([tenantId, active, priority])
  @@index([tenantId, provider, active])
}

// Espelho local dos templates aprovados da WABA (sync-only — criação/aprovação
// acontece no Business Manager da Meta). status como String: a Meta muda o set.
model WabaTemplate {
  id         String   @id @default(cuid())
  tenantId   String
  wabaId     String
  externalId String?
  name       String
  language   String // ex: pt_BR
  category   String // MARKETING | UTILITY | AUTHENTICATION
  status     String // APPROVED | PENDING | REJECTED | PAUSED | DISABLED...
  components Json // resposta crua de GET /{waba_id}/message_templates
  syncedAt   DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@unique([tenantId, wabaId, name, language])
  @@index([tenantId, status])
}

enum CampaignStatus {
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELED
}

enum CampaignAudience {
  LEAD
  BUYER
  ALL
}

enum CampaignMessageStatus {
  PENDING // snapshot criado, aguardando budget/onda
  QUEUED // atribuído a uma instância, job single enfileirado
  SENT // aceito pela Cloud API (tem providerMessageId)
  DELIVERED
  READ
  FAILED
  SKIPPED // campanha cancelada / contato inválido
}

// Campanha de disparo 1:1 via Cloud API oficial. Distribuição round-robin
// entre as instâncias CLOUD_API respeitando dailyCap (janela móvel 24h).
model Campaign {
  id                String           @id @default(cuid())
  tenantId          String
  name              String
  templateId        String
  // Parâmetros posicionais do body do template ({{1}}, {{2}}...). Cada item é
  // literal OU token "{{contact.name}}" | "{{contact.email}}" | "{{contact.phone}}"
  templateVariables Json             @default("[]")
  // URL pública pra header IMAGE/VIDEO/DOCUMENT (link-based)
  headerMediaUrl    String?
  audienceKind      CampaignAudience
  // Seleção manual opcional de contatos; vazio = audiência inteira do kind
  contactIds        String[]         @default([])
  // Instâncias CLOUD_API a usar; vazio = todas ativas do tenant
  instanceIds       String[]         @default([])
  throttlePerMinute Int              @default(60)
  startAt           DateTime
  status            CampaignStatus   @default(SCHEDULED)
  totalTargets      Int              @default(0)
  bullJobId         String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template WabaTemplate      @relation(fields: [templateId], references: [id])
  messages CampaignMessage[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

// Log por destinatário — alimenta o dashboard (contagem por número, funil de
// entrega, % enviado). Status atualizado pelo webhook da Meta via providerMessageId.
model CampaignMessage {
  id                String                @id @default(cuid())
  tenantId          String
  campaignId        String
  contactId         String?
  phone             String
  // Snapshot do kind no momento do disparo (lead pode virar buyer depois)
  contactKind       ContactKind
  instanceId        String?
  phoneNumberId     String?
  // wamid — chave de lookup do webhook de status
  providerMessageId String?               @unique
  status            CampaignMessageStatus @default(PENDING)
  errorCode         String?
  errorMessage      String?
  queuedAt          DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  instance Instance? @relation(fields: [instanceId], references: [id], onDelete: SetNull)

  @@unique([campaignId, phone])
  @@index([tenantId, campaignId, status])
  @@index([tenantId, instanceId, sentAt])
  @@index([tenantId, contactKind, status])
  @@index([tenantId, sentAt])
  @@index([campaignId, status])
}

enum ContactKind {
  LEAD
  BUYER
}

// Contatos 1:1 sincronizados de fonte externa (hotwebinar) ou cadastrados via API.
// comprador = comprou_at IS NOT NULL na origem.
model Contact {
  id          String      @id @default(cuid())
  tenantId    String
  // Dígitos E.164 sem "+", canônico BR COM 9º dígito (convenção do repo)
  phone       String
  kind        ContactKind
  name        String?
  email       String?
  source      String      @default("hotwebinar")
  // Telefone cru na origem (PK do hotwebinar), sem normalizar — preserva o link
  externalRef String?
  boughtAt    DateTime?
  firstSeenAt DateTime?
  lastSeenAt  DateTime?
  syncedAt    DateTime
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages CampaignMessage[]

  @@unique([tenantId, phone])
  @@index([tenantId, kind])
  @@index([tenantId, lastSeenAt])
}

// Estado do sync incremental com o hotwebinar (1 por tenant, operado só pelo worker)
model ContactSyncState {
  id             String    @id @default(cuid())
  tenantId       String    @unique
  // Watermark: max last_seen processado no incremental
  lastSeenCursor DateTime?
  lastFullSyncAt DateTime?
  lastRunAt      DateTime?
  lastRunStatus  String? // SUCCESS | FAILED
  lastRunError   String?
  lastRunUpserts Int       @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

enum ExecStatus {
  SUCCESS
  FAILED
  SKIPPED
}

model Execution {
  id                    String     @id @default(cuid())
  tenantId              String
  scheduleId            String?
  groupUpdateScheduleId String?
  ranAt                 DateTime   @default(now())
  status                ExecStatus
  groupRemoteId         String?
  instanceName          String?
  responsePayload       Json?
  errorMessage          String?

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  schedule            Schedule?            @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  groupUpdateSchedule GroupUpdateSchedule? @relation(fields: [groupUpdateScheduleId], references: [id], onDelete: SetNull)

  @@index([tenantId, ranAt])
  @@index([scheduleId])
  @@index([groupUpdateScheduleId])
  @@index([tenantId, instanceName, ranAt])
  @@index([tenantId, status, ranAt])
}
